-record(node, {
    node_id :: chrobot_extra@protocol@dom:node_id(),
    parent_id :: gleam@option:option(chrobot_extra@protocol@dom:node_id()),
    backend_node_id :: chrobot_extra@protocol@dom:backend_node_id(),
    node_type :: integer(),
    node_name :: binary(),
    local_name :: binary(),
    node_value :: binary(),
    child_node_count :: gleam@option:option(integer()),
    children :: gleam@option:option(list(chrobot_extra@protocol@dom:node_())),
    attributes :: gleam@option:option(list(binary())),
    document_url :: gleam@option:option(binary()),
    base_url :: gleam@option:option(binary()),
    public_id :: gleam@option:option(binary()),
    system_id :: gleam@option:option(binary()),
    internal_subset :: gleam@option:option(binary()),
    xml_version :: gleam@option:option(binary()),
    name :: gleam@option:option(binary()),
    value :: gleam@option:option(binary()),
    pseudo_type :: gleam@option:option(chrobot_extra@protocol@dom:pseudo_type()),
    pseudo_identifier :: gleam@option:option(binary()),
    shadow_root_type :: gleam@option:option(chrobot_extra@protocol@dom:shadow_root_type()),
    frame_id :: gleam@option:option(binary()),
    content_document :: gleam@option:option(chrobot_extra@protocol@dom:node_()),
    shadow_roots :: gleam@option:option(list(chrobot_extra@protocol@dom:node_())),
    template_content :: gleam@option:option(chrobot_extra@protocol@dom:node_()),
    pseudo_elements :: gleam@option:option(list(chrobot_extra@protocol@dom:node_())),
    distributed_nodes :: gleam@option:option(list(chrobot_extra@protocol@dom:backend_node())),
    is_svg :: gleam@option:option(boolean()),
    compatibility_mode :: gleam@option:option(chrobot_extra@protocol@dom:compatibility_mode()),
    assigned_slot :: gleam@option:option(chrobot_extra@protocol@dom:backend_node())
}).
