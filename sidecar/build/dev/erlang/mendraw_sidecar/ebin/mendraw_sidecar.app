{application, mendraw_sidecar, [
    {vsn, "1.0.0"},
    {applications, [chrobot_extra,
                    gleam_erlang,
                    gleam_http,
                    gleam_json,
                    gleam_otp,
                    gleam_stdlib,
                    mist,
                    simplifile]},
    {description, "HTTP sidecar for mendraw Marketplace browser automation"},
    {modules, [mendraw_sidecar,
               mendraw_sidecar@@main,
               mendraw_sidecar@http_utils,
               mendraw_sidecar@router,
               mendraw_sidecar@session_handler,
               mendraw_sidecar@version_handler,
               mendraw_sidecar@xas_parser]},
    {registered, []}
]}.
